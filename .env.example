# ─────────────────────────────────────────────────────────────
# Variables PÚBLICAS (frontend). Se exponen en el navegador y
# van tanto en tu .env local como en las variables de entorno del
# sitio en Netlify.
# ─────────────────────────────────────────────────────────────

# URL de tu proyecto Supabase (Project Settings → API).
VITE_SUPABASE_URL=

# Clave "anon public" de Supabase (Project Settings → API).
# Es segura para el frontend: la protección real la da RLS en Postgres.
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Variables PRIVADAS. NUNCA deben llevar el prefijo VITE_ (si lo
# llevaran, Vite las incluiría en el bundle del navegador). Solo
# se usan dentro de netlify/functions y solo deben configurarse
# como variables de entorno en el dashboard de Netlify, nunca en
# un .env que se commitee.
# ─────────────────────────────────────────────────────────────

# Misma URL que arriba, sin prefijo VITE_ (la usan las Netlify Functions).
SUPABASE_URL=

# Clave "service_role" de Supabase (Project Settings → API).
# Tiene privilegios totales y evita RLS. JAMÁS exponerla en el frontend
# ni commitearla en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=
